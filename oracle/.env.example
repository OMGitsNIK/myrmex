RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=9naJhrt9FdAHLwdLnQfgx6citNgEWmW8aLovCS9kYpan
ANTHROPIC_API_KEY=sk-ant-...

# Oracle keypair — JSON array of bytes (Railway secret)
# Generate with: solana-keygen new -o oracle-keypair.json
ORACLE_KEYPAIR_JSON=[1,2,3,...]

# Pool pubkeys (set after running setup-pool-configs.ts)
FLIGHT_POOL=
CROP_POOL=
DEFI_POOL=

# Polling interval in seconds
POLL_INTERVAL_SECS=300

# Crop monitoring location (default: Chicago)
CROP_LAT=41.8781
CROP_LON=-87.6298

# DeFi protocol to monitor
DEFI_PROTOCOL=aave-v3

# For flight delay demo — set a non-zero value to simulate a delay
MOCK_FLIGHT_DELAY_MINUTES=0
